# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tekgen_ats"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="7d"

# OpenRouter
OPENROUTER_API_KEY="sk-your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-4.1-mini"

# Demo account for testing
DEMO_USER_EMAIL="demo@tekgen.com"
DEMO_USER_PASSWORD="Demo@1234"
DEMO_USER_FIRST_NAME="Demo"
DEMO_USER_LAST_NAME="Recruiter"
DEMO_JOB_TITLE="Software Engineer"
DEMO_JOB_DESCRIPTION="Looking for a practical software engineer with recent experience in JavaScript, Node.js, and React."
DEMO_JOB_REQUIRED_SKILLS="JavaScript,Node.js,React"

# Email Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@tekgen.com.my"

# Server
PORT=5000
NODE_ENV="development"
API_BASE_URL="http://localhost:5000"

# Frontend
FRONTEND_URL="http://localhost:3000"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"
