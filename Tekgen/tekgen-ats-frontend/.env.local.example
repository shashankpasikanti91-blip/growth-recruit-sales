# Tekgen ATS Frontend Configuration

# API — use NEXT_PUBLIC_API_BASE_URL (see lib/api.js)
# For Next dev (UI :3000, API :5000): http://localhost:5000
# For static UI served by Express on :5000 or via ngrok: leave empty so /api uses same origin as the page
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_TIMEOUT=30000

# Authentication
NEXT_PUBLIC_AUTH_EXPIRY=24h

# Feature Flags
NEXT_PUBLIC_ENABLE_ADVANCED_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PREDICTIVE_INSIGHTS=true
NEXT_PUBLIC_ENABLE_EMAIL_TEMPLATES=true

# UI Configuration
NEXT_PUBLIC_ITEMS_PER_PAGE=10
NEXT_PUBLIC_THEME=light

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Environment
NODE_ENV=development
